# vocab-card proxy environment template
# Copy to .env and fill real values. NEVER commit the real file.

# --- Model (OpenAI-compatible Chat Completions) ---
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model-name
# Set to true when the model accepts image inputs (photo OCR path).
MODEL_SUPPORTS_VISION=false

# --- Secrets ---
MODEL_API_KEY=sk-replace-me
APP_SHARED_ACCESS_CODE=replace-with-a-code-you-share-with-friends

# --- OCR ---
# vision = use the vision-capable model above; remote = separate OCR service.
OCR_PROVIDER=vision
# OCR_API_URL=https://ocr.example.com
# OCR_API_KEY=

# --- Access control ---
# The origin of the deployed PWA (GitHub Pages URL).
ALLOWED_ORIGIN=https://yourusername.github.io
PORT=8787
